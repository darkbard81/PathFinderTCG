    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  }
