{
  "name": "pathfinder-tcg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch src/server/start.ts",
    "start:api": "tsx src/server/start.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:cards:prompts": "tsx scripts/card-assets/print-generation-prompts.js",
    "assets:cards:prompts:validate": "tsx scripts/card-assets/validate-card-prompt-contract.js",
    "assets:cards:build": "tsx scripts/card-assets/build-runtime-assets.js",
    "assets:cards:validate": "/usr/bin/python scripts/card-assets/validate_card_assets.py",
    "assets:cards:test": "/usr/bin/python -m unittest scripts/card-assets/validate_card_assets_test.py && npm run assets:cards:prompts:validate",
    "assets:cards:log:validate": "tsx scripts/card-assets/validate-generation-log.js"
  },
  "dependencies": {
    "@fastify/cookie": "10.0.1",
    "@fastify/rate-limit": "10.3.0",
    "ajv": "8.20.0",
    "better-sqlite3": "12.9.0",
    "fastify": "5.10.0",
    "phaser": "4.2.1",
    "phaser4-rex-plugins": "4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "7.6.13",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "sharp": "^0.35.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
